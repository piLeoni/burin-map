{
  "rewrites": [
    {
      "source": "/terrarium/:path*",
      "destination": "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/:path*"
    },
    {
      "source": "/docs/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
