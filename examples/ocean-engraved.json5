// Engraved sea: dense lines following gentle currents, all waving evenly and
// in step, each an offset copy of the next. Near the coast they break up into
// dashes and dots with a ragged edge, clear of the concentric coast lines.
// Made for the screen: a plotter would take hours over the sea.
//   burin-map --style-file examples/ocean-engraved.json5 --out-file examples/ocean-engraved.png
{
  area: { at: "37.7,-122.62", size_km: [40, 28] },
  batches: [
    {
      angle: 0,
      style: { space_light: 1.8, space_dark: 0.6, space_steep: 0.3, dash_light: 0.1 },
    },
  ],
  water: {
    shoreline: { lines: 2, style: { space: 1.5 } },
    batches: [
      { follow: "shore", angle: 0, style: { space: 3, water_start: 3, water_reach: 20 } },
      {
        follow: "map",
        angle: 90,
        style: {
          space: 4,
          space_light: 1,
          space_dark: 1,
          water_start: 26,
          water_reach: 4000,
          water_fade: 0.2,
          water_fray: 40,
          dash_light: 0.95,
          dash_dark: 1,
          dash_period: 9,
          dash_drop: 0,
          mod_jitter: 0.3,
          mod_wobble: 45,
          mod_wobble_size: 120,
          mod_smooth: 3,
          mod_wave: 2.5,
          mod_wave_size: 30,
          mod_wave_even: 1,
        },
      },
    ],
  },
}
