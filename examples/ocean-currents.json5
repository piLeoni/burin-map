// Swirling currents over the open sea: dense lines that curl as the flow
// turns, waving together so neighbours stay evenly spaced. Kept clear of the
// concentric lines along the coast by water_start. Made for the screen: a
// plotter would take hours over the sea.
//   burin-map --style-file examples/ocean-currents.json5 --out-file examples/ocean-currents.png
{
  area: { at: "37.7,-122.62", size_km: [40, 28] },
  batches: [
    {
      angle: 0,
      style: { space_light: 8.6, space_dark: 2.9, space_steep: 0.3, dash_light: 0.1 },
    },
  ],
  water: {
    shoreline: { lines: 2, style: { space_light: 1.5 } },
    batches: [
      { follow: "shore", angle: 0, style: { space_light: 5.4, space_dark: 2.4, water_start: 3, water_reach: 20 } },
      {
        follow: "map",
        angle: 90,
        style: {
          space_light: 5,
          space_dark: 5,
          water_start: 27,
          water_reach: 4000,
          water_fade: 0.2,
          dash_light: 0.85,
          dash_dark: 0.95,
          dash_period: 45,
          mod_jitter: 0.3,
          mod_wobble: 70,
          mod_wobble_size: 60,
          mod_smooth: 3,
          mod_wave: 2.5,
          mod_wave_size: 60,
          mod_wave_zone: 1,
        },
      },
    ],
  },
}
